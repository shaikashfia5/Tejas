# Tejas — Environment Variables Template
# Copy this file to .env or .env.local

# Standard format
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Vite client variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Next.js client variables
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Gemini API Key (for receipt structuring — keep secret in Supabase Edge env, optional client fallback)
VITE_GEMINI_API_KEY=your-gemini-api-key

# App URL
VITE_APP_URL=http://localhost:5173
