[TEMPLATE]
# Tejas — Environment Variables Template
# Copy this file to .env or .env.local (never commit the real file)

# Supabase (client-side, public anon key only — RLS protects the data)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# App URL
VITE_APP_URL=http://localhost:5173

# ── Server-side only (NEVER prefix these with VITE_) ──────────────────────
# Gemini API key for receipt parsing: set it as a Supabase Edge Function
# secret so it never ships in the client bundle:
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
